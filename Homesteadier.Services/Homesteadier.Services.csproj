<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      CS8509 = a switch expression isn't exhaustive. Controllers map these services' status enums
      onto HTTP responses with discard-free switch expressions, so adding a status without giving
      it a response is exactly this warning. Promoted to an error there; kept here so any switch
      inside the services themselves gets the same treatment.
    -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
    <NoWarn>$(NoWarn);CS8524</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Communication.Email" Version="1.1.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HomeSteadier.Models\HomeSteadier.Models.csproj" />
    <ProjectReference Include="..\Homesteadier.Repository\Homesteadier.Repository.csproj" />
  </ItemGroup>

</Project>
